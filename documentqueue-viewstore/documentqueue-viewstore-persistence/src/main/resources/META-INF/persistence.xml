<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="documentqueue">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:/DS.documentqueue</jta-data-source>
        <class>uk.gov.moj.cpp.prosecution.documentqueue.entity.Document</class>
        <class>uk.gov.moj.cpp.prosecution.documentqueue.entity.CaseStatus</class>
    </persistence-unit>

</persistence>
